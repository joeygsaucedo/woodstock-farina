# Public site origin used for canonical tags, Open Graph URLs, robots.txt and
# the sitemap. Defaults to the Vercel URL; set this to the custom domain once
# woodstockfarina.com actually resolves.
PUBLIC_SITE_URL=https://project-bo5zl.vercel.app

# Booking policy
BOOKING_MIN_NOTICE_DAYS=7
BOOKING_DEFAULT_DURATION_HOURS=5
BOOKING_SERVICE_START_HOUR=10
BOOKING_SERVICE_END_HOUR=21
BOOKING_TIMEZONE=America/Los_Angeles

# Calendar settings
BOOKING_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Email settings (booking + contact notifications)
# Configured for Gmail. SMTP_PASS must be a 16-character app password from
# https://myaccount.google.com/apppasswords (requires 2-Step Verification),
# not the account password. Enter it with no spaces.
# Gmail rewrites the From header to SMTP_USER unless SMTP_FROM_EMAIL is a
# verified "Send mail as" alias, so keep the two the same.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=Woodstockfarina@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_EMAIL=Woodstockfarina@gmail.com
SMTP_FROM_NAME=Woodstock Farina
CORPORATE_EMAIL_TO=Woodstockfarina@gmail.com

# Events admin panel
# A second Google Calendar, separate from bookings, shared with the same
# service account with "Make changes to events" permission.
EVENTS_CALENDAR_ID=your_events_calendar@group.calendar.google.com
# Password for /admin. Use something long; it is the only credential.
ADMIN_PASSWORD=choose_a_long_random_password
# Signs the admin session cookie. Any long random string; rotating it logs
# everyone out.
ADMIN_SESSION_SECRET=generate_with_openssl_rand_base64_32
# Supplied automatically by Vercel once a Blob store is attached.
BLOB_READ_WRITE_TOKEN=
# Guards the scheduled cleanup endpoint so only Vercel Cron can run it.
CRON_SECRET=generate_with_openssl_rand_base64_32
