---
import Layout from '../layouts/Layout.astro';
import { GALLERY_CATEGORIES, getGalleryPhotos, photoSrc, type GalleryPhoto } from '../lib/googlePhotos';

export const prerender = false;

// Photos come live from the owner's Google Photos albums. Cache at the CDN for
// an hour so album changes show up within the hour without each visit
// re-reading Google.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const allPhotos = await getGalleryPhotos();

// Only offer filters for categories that actually have photos.
const categories = GALLERY_CATEGORIES.filter((c) => allPhotos.some((p) => p.category === c.id));
const labelFor = new Map(GALLERY_CATEGORIES.map((c) => [c.id, c.label]));

// Interleave the albums so "All" shows a mix rather than one album after another.
const byCategory = categories.map((c) => allPhotos.filter((p) => p.category === c.id));
const photos: GalleryPhoto[] = [];
for (let i = 0; byCategory.some((list) => i < list.length); i++) {
  for (const list of byCategory) {
    if (list[i]) photos.push(list[i]);
  }
}
---

<Layout
  title="Gallery - Woodstock Farina | Event Photos"
  description="Browse photos of Woodstock Farina's wood-fired pizza catering across Ventura County: weddings, corporate events and festivals, celebrations, backyard gatherings, and more."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-wood-800 to-wood-900 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-heading font-bold mb-4">
        Our Gallery
      </h1>
      <p class="text-xl text-wood-100 max-w-2xl mx-auto">
        Celebrating special moments across Ventura County with authentic wood-fired pizza
      </p>
    </div>
  </section>

  <!-- Filter Buttons -->
  <section class="py-6 bg-wood-50 border-b border-wood-200 sticky top-20 z-40">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-3">
        <button
          type="button"
          class="category-filter px-5 py-2 rounded-full font-semibold transition-all hover:scale-105"
          data-category="all"
          aria-pressed="true"
        >
          All
        </button>
        {categories.map((category) => (
          <button
            type="button"
            class="category-filter px-5 py-2 rounded-full font-semibold transition-all hover:scale-105"
            data-category={category.id}
            data-blurb={category.blurb}
            aria-pressed="false"
          >
            {category.label}
          </button>
        ))}
      </div>
      <p id="category-blurb" class="mt-3 text-center text-wood-600 min-h-[1.5rem]" aria-live="polite"></p>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-12 md:py-16 bg-white">
    <div class="container mx-auto px-4">
      {photos.length === 0 ? (
        <p class="text-center text-wood-600 text-lg py-12">
          Photos are on their way. Check back soon!
        </p>
      ) : (
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-4" id="gallery-grid">
          {photos.map((photo, index) => (
            <button
              type="button"
              class="gallery-item group mb-4 block w-full break-inside-avoid overflow-hidden rounded-lg bg-wood-100 shadow-md hover:shadow-xl focus:outline-none focus-visible:ring-4 focus-visible:ring-fire-400"
              data-category={photo.category}
              data-image={photo.baseUrl}
              data-sizable={photo.width ? 'true' : undefined}
              data-label={labelFor.get(photo.category)}
              aria-label={`Open ${labelFor.get(photo.category)} photo`}
            >
              <img
                src={photoSrc(photo, 800)}
                srcset={photo.width ? `${photoSrc(photo, 500)} 500w, ${photoSrc(photo, 800)} 800w, ${photoSrc(photo, 1200)} 1200w` : undefined}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                width={photo.width || undefined}
                height={photo.height || undefined}
                alt={`${labelFor.get(photo.category)} catering by Woodstock Farina`}
                loading={index < 6 ? 'eager' : 'lazy'}
                decoding="async"
                referrerpolicy="no-referrer"
                class="block h-auto w-full transition-transform duration-500 group-hover:scale-105"
              />
            </button>
          ))}
        </div>
      )}
    </div>
  </section>

  <div
    id="gallery-lightbox"
    class="hidden fixed inset-0 z-[100] bg-black/90 p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
  >
    <button
      id="lightbox-close"
      type="button"
      class="absolute right-4 top-4 md:right-8 md:top-8 z-10 text-white/90 hover:text-white text-3xl leading-none"
      aria-label="Close photo viewer"
    >
      &times;
    </button>

    <button
      id="lightbox-prev"
      type="button"
      class="absolute left-2 top-1/2 -translate-y-1/2 md:left-6 z-10 text-white/90 hover:text-white text-4xl px-3 py-2"
      aria-label="Previous photo"
    >
      &#10094;
    </button>

    <button
      id="lightbox-next"
      type="button"
      class="absolute right-2 top-1/2 -translate-y-1/2 md:right-6 z-10 text-white/90 hover:text-white text-4xl px-3 py-2"
      aria-label="Next photo"
    >
      &#10095;
    </button>

    <div class="mx-auto flex h-full max-w-6xl items-center justify-center">
      <div class="w-full max-w-5xl" id="lightbox-content">
        <img
          id="lightbox-image"
          src=""
          alt=""
          referrerpolicy="no-referrer"
          class="max-h-[80vh] w-full rounded-lg object-contain"
        />
        <p class="mt-4 text-center text-white/80">
          <span id="lightbox-label" class="font-heading font-bold text-white"></span>
          <span id="lightbox-counter" class="ml-2 text-sm"></span>
        </p>
      </div>
    </div>
  </div>

  <!-- Behind the Scenes -->
  <section class="py-20 bg-wood-50">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl md:text-5xl font-heading font-bold text-wood-900 mb-4">
            Behind the Scenes
          </h2>
          <p class="text-lg text-wood-600">
            A glimpse into how we create magic at every event
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
            <img
              src="/images/team/oven-setup.jpg"
              alt="Wood-fired oven setup"
              class="h-64 w-full object-cover"
            />
            <div class="p-6">
              <h3 class="text-xl font-heading font-bold text-wood-900 mb-2">
                The Oven Setup
              </h3>
              <p class="text-wood-600">
                Our mobile wood-fired oven reaches 800°F, creating the perfect cooking environment for authentic pizza.
              </p>
            </div>
          </div>

          <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
            <img
              src="/images/team/pizza-making.jpg"
              alt="Crafting pizza by hand"
              class="h-64 w-full object-cover"
            />
            <div class="p-6">
              <h3 class="text-xl font-heading font-bold text-wood-900 mb-2">
                Crafting Each Pizza
              </h3>
              <p class="text-wood-600">
                Every pizza is hand-stretched and topped fresh on-site, ensuring the highest quality for your guests.
              </p>
            </div>
          </div>

          <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
            <img
              src="/images/team/oven-fire.jpg"
              alt="Pizza cooking in wood fire"
              class="h-64 w-full object-cover"
            />
            <div class="p-6">
              <h3 class="text-xl font-heading font-bold text-wood-900 mb-2">
                Fresh From the Fire
              </h3>
              <p class="text-wood-600">
                Pizzas cook in just 90 seconds, emerging with the perfect char and smoky flavor that only wood-fire provides.
              </p>
            </div>
          </div>

          <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
            <img
              src="/images/team/serving.jpg"
              alt="Serving fresh pizza"
              class="h-64 w-full object-cover"
            />
            <div class="p-6">
              <h3 class="text-xl font-heading font-bold text-wood-900 mb-2">
                Happy Guests
              </h3>
              <p class="text-wood-600">
                Watching guests enjoy fresh, hot pizza at your event is what makes our work so rewarding.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-heading font-bold text-wood-900 mb-4">
            By the Numbers
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-5xl font-heading font-bold text-fire-600 mb-2">500+</div>
            <div class="text-wood-600 font-medium">Events Catered</div>
          </div>
          <div>
            <div class="text-5xl font-heading font-bold text-fire-600 mb-2">15K+</div>
            <div class="text-wood-600 font-medium">Pizzas Made</div>
          </div>
          <div>
            <div class="text-5xl font-heading font-bold text-fire-600 mb-2">25K+</div>
            <div class="text-wood-600 font-medium">Happy Guests</div>
          </div>
          <div>
            <div class="text-5xl font-heading font-bold text-fire-600 mb-2">20+</div>
            <div class="text-wood-600 font-medium">Years of Combined Culinary Experience</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-fire-600 to-fire-700 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-heading font-bold mb-6">
        Ready to Create Memories?
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        Let's make your event the next one featured in our gallery!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/booking"
          class="bg-white text-fire-600 px-8 py-4 rounded-full font-semibold text-lg hover:bg-wood-50 transition-all transform hover:scale-105"
        >
          Book Your Event
        </a>
        <a
          href="/menu"
          class="bg-fire-800 text-white px-8 py-4 rounded-full font-semibold text-lg hover:bg-fire-900 transition-all transform hover:scale-105"
        >
          View Menu
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('.category-filter')) as HTMLButtonElement[];
  const galleryItems = Array.from(document.querySelectorAll('.gallery-item')) as HTMLButtonElement[];
  const blurb = document.getElementById('category-blurb');

  const lightbox = document.getElementById('gallery-lightbox') as HTMLDivElement | null;
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxLabel = document.getElementById('lightbox-label');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxClose = document.getElementById('lightbox-close') as HTMLButtonElement | null;
  const lightboxPrev = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
  const lightboxNext = document.getElementById('lightbox-next') as HTMLButtonElement | null;
  const lightboxContent = document.getElementById('lightbox-content') as HTMLDivElement | null;

  const ACTIVE = ['bg-fire-600', 'text-white'];
  const INACTIVE = ['bg-white', 'text-wood-700', 'hover:bg-wood-100'];

  let currentLightboxIndex = -1;
  let lastFocused: HTMLElement | null = null;

  const getVisibleGalleryItems = () => galleryItems.filter((item) => !item.hidden);

  // Google serves any width on request: ask for one that fills this screen
  // (rounded up to a step so the browser cache is shared across opens).
  const fullSizeUrl = (item: HTMLElement) => {
    const base = item.dataset.image ?? '';
    if (!item.dataset.sizable) return base;
    const needed = Math.min(window.innerWidth, 1280) * Math.min(window.devicePixelRatio || 1, 2);
    const width = Math.min(2400, Math.ceil(needed / 400) * 400);
    return `${base}=w${width}`;
  };

  // The grid has already downloaded a smaller copy; show it at once.
  const thumbnailUrl = (item: HTMLElement) => item.querySelector('img')?.currentSrc ?? '';

  const loaded = new Set<string>();
  const preload = (url: string) => {
    if (!url || loaded.has(url)) return;
    const img = new Image();
    img.referrerPolicy = 'no-referrer';
    img.onload = () => loaded.add(url);
    img.src = url;
  };

  const renderLightbox = (index: number) => {
    const visibleItems = getVisibleGalleryItems();
    if (!visibleItems.length || !lightboxImage) return;

    const count = visibleItems.length;
    const boundedIndex = (index + count) % count;
    const item = visibleItems[boundedIndex];
    currentLightboxIndex = boundedIndex;

    const full = fullSizeUrl(item);
    if (loaded.has(full)) {
      lightboxImage.src = full;
    } else {
      lightboxImage.src = thumbnailUrl(item) || full;
      const hiRes = new Image();
      hiRes.referrerPolicy = 'no-referrer';
      hiRes.onload = () => {
        loaded.add(full);
        // Only swap if the visitor is still on this photo.
        if (currentLightboxIndex === boundedIndex && getVisibleGalleryItems()[boundedIndex] === item) {
          lightboxImage.src = full;
        }
      };
      hiRes.src = full;
    }

    // Warm up the neighbours so the arrows feel instant.
    if (count > 1) {
      preload(fullSizeUrl(visibleItems[(boundedIndex + 1) % count]));
      preload(fullSizeUrl(visibleItems[(boundedIndex - 1 + count) % count]));
    }

    lightboxImage.alt = `${item.dataset.label ?? 'Gallery'} photo`;
    if (lightboxLabel) lightboxLabel.textContent = item.dataset.label ?? '';
    if (lightboxCounter) lightboxCounter.textContent = `${boundedIndex + 1} / ${visibleItems.length}`;
  };

  const openLightboxForItem = (item: HTMLElement) => {
    const index = getVisibleGalleryItems().indexOf(item as HTMLButtonElement);
    if (index < 0 || !lightbox) return;

    lastFocused = item;
    renderLightbox(index);
    lightbox.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    lightboxClose?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    currentLightboxIndex = -1;
    lastFocused?.focus();
  };

  const showPrev = () => {
    if (currentLightboxIndex >= 0) renderLightbox(currentLightboxIndex - 1);
  };

  const showNext = () => {
    if (currentLightboxIndex >= 0) renderLightbox(currentLightboxIndex + 1);
  };

  const selectCategory = (button: HTMLButtonElement) => {
    const category = button.dataset.category ?? 'all';

    filterButtons.forEach((btn) => {
      const active = btn === button;
      btn.classList.remove(...(active ? INACTIVE : ACTIVE));
      btn.classList.add(...(active ? ACTIVE : INACTIVE));
      btn.setAttribute('aria-pressed', String(active));
    });

    if (blurb) blurb.textContent = button.dataset.blurb ?? '';

    galleryItems.forEach((item) => {
      item.hidden = category !== 'all' && item.dataset.category !== category;
    });
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => selectCategory(button));
  });
  if (filterButtons[0]) selectCategory(filterButtons[0]);

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => openLightboxForItem(item));
    // Start the full-size download as soon as the visitor shows intent.
    item.addEventListener('pointerenter', () => preload(fullSizeUrl(item)), { once: true });
    item.addEventListener('focus', () => preload(fullSizeUrl(item)), { once: true });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', showPrev);
  lightboxNext?.addEventListener('click', showNext);

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  lightboxContent?.addEventListener('click', (event) => {
    event.stopPropagation();
  });

  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft') showPrev();
    if (event.key === 'ArrowRight') showNext();
  });
</script>
